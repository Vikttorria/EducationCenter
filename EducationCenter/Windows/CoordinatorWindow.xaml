<Window x:Class="EducationCenter.Windows.CoordinatorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:EducationCenter.Windows"
        mc:Ignorable="d"
        Title="Координатор" Height="1004" Width="1920" WindowStartupLocation="CenterScreen" 
        ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="20"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Панель поиска -->
        <Border  Margin="0 20 0 20">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="10"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="50"/>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="1*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="2" Text="Логин" />
                <TextBox x:Name="EmployeeIdTb" Grid.Row="3" />

                <TextBlock Grid.Row="5" Text="Фамилия" />
                <TextBox x:Name="EmployeeNameTb" Grid.Row="6" />

                <Button x:Name="SearchBtn" Grid.Row="7" Content="Поиск" Click="SearchBtn_Click"  Margin="0 20 0 0"/>

                <Grid Grid.Row="9">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="AddBtn" Content="Добавить" Click="AddBtn_Click"  Margin="0 0 10 0"/>
                    <Button x:Name="EditBtn" Content="Редактировать" Grid.Column="1" Click="EditBtn_Click"  Margin="10 0 0 0" />
                </Grid>
            </Grid>
        </Border>


        <Grid Grid.Column="2" Margin="0 20 20 20">

            <Grid.RowDefinitions>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Список клиентов -->
            <ListView x:Name="EmployeeLv"
                   SelectionChanged="EmployeeLv_SelectionChanged">

                <ListView.View>
                    <GridView>
                        <GridViewColumn  Header="ID" Width="Auto" DisplayMemberBinding="{Binding Id}"/>
                        <GridViewColumn Header="ФИО" Width="Auto" DisplayMemberBinding="{Binding FullName}"/>
                        <GridViewColumn Header="Должность" Width="Auto" DisplayMemberBinding="{Binding Position.Name}"/>
                        <GridViewColumn Header="Отдел" Width="Auto" DisplayMemberBinding="{Binding Department.Name}"/>
                        <GridViewColumn Header="E-mail" Width="Auto" DisplayMemberBinding="{Binding Email}"/>
                        <GridViewColumn Header="Номер телефона" Width="Auto" DisplayMemberBinding="{Binding Phone}"/>
                        <GridViewColumn Header="Дата найма" Width="Auto" DisplayMemberBinding="{Binding HireDate}"/>
                        <GridViewColumn Header="Заблокирован" Width="Auto" DisplayMemberBinding="{Binding IsActive}"/>
                        <GridViewColumn Header="Заметки" Width="Auto" DisplayMemberBinding="{Binding Note}"/>
                        
                    </GridView>
                </ListView.View>
            </ListView>


        </Grid>
    </Grid>
</Window>
